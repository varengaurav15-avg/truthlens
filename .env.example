# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#   cp .env.example .env

# ── LLM adjudicator ──────────────────────────────────────────
# Provider: auto | groq | gemini | openai | openrouter | ollama | none
#   groq    free tier, serves Llama-3.3-70B    -> console.groq.com
#   ollama  fully local, no key, lower accuracy -> ollama.com
#   none    disables LLM adjudication; NLI verdict becomes final
llm_provider=groq
llm_api_key=

# Optional overrides — blank uses the provider default
llm_model=
llm_base_url=
llm_timeout=45
llm_max_claims=8

# ── Evidence retrieval ───────────────────────────────────────
# false = offline mode, uses only the curated facts in data/kg_facts.json
enable_wiki_evidence=true
wiki_timeout=15

# ── Neo4j knowledge graph (optional) ─────────────────────────
# If unreachable the system falls back to data/kg_facts.json automatically,
# so these can be left blank for local development.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# ── HuggingFace (optional) ───────────────────────────────────
# Raises model download rate limits
hf_token=
